{
  "name": "clang-ast-to-source-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clang AST text and JSON reconstruction workspace",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "convert": "node scripts/convert.mjs",
    "test:e2e": "node e2e/workspace.mjs",
    "format": "prettier --write src tests e2e scripts index.html",
    "format:check": "prettier --check src tests e2e scripts index.html"
  },
  "dependencies": {
    "@wasm-fmt/clang-format": "^23.1.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0"
  }
}
